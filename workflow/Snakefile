from snakemake.utils import min_version

min_version("9.0")


configfile: "config/config.yaml"


wildcard_constraints:
    id=r"[^/]+",
    phenotype=r"[A-Za-z]+",
    population=r"[A-Z]+",


include: "rules/common.smk"
include: "rules/input.smk"
include: "rules/ldsc.smk"
include: "rules/meta.smk"
include: "rules/finemapping.smk"
include: "rules/annotation.smk"


rule all:
    input:
        "results/qc/variant_counts.tsv",
        expand("data/processed/ldsc-stats/{id}.txt", id=ids),
        pair_paths(
            "data/processed/meta-formatted/{phenotype}-{population}_meta_formatted.txt",
            meta_pairs,
        ),
        pair_paths(
            "results/mqq-plots/meta/{phenotype}-{population}_mqq_plot.png", valid_pairs
        ),
        pair_paths(
            "data/processed/finemapping/{phenotype}-{population}_bayesian_finemapping.txt",
            valid_pairs,
        ),
        pair_paths(
            "data/processed/vep/output/{phenotype}-{population}.txt", valid_pairs
        ),
        "data/processed/finemapping/HyPrColoc_results.txt",
        expand(
            "data/processed/ldsc-seg/{phenotype}-{population}.cell_type_results.txt",
            phenotype=downstream,
            population=config["ldsc_seg"]["population"],
        ),
        expand("data/processed/pops/{phenotype}.preds", phenotype=downstream),
        expand(
            "data/processed/variant-annotation/eqtl/{phenotype}_eqtl_colocalization.txt",
            phenotype=downstream,
        ),
