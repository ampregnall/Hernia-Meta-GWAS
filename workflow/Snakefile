from pathlib import Path
import pandas as pd
import yaml

configfile: "config/config.yaml"

include: "rules/input.smk"
include: "rules/ldsc.smk"
include: "rules/meta.smk"

def get_input(wc):
    df = pd.read_table("config/studies.txt")
    files = df.apply(lambda x: f'data/processed/gwas-summary-statistics/{x["study"]}_{x["phenotype"]}_{x["population"]}.txt', axis = 1).tolist()    
    return files

def get_ldsc(wc):
    df = pd.read_table("config/studies.txt")
    files = df.apply(lambda x: f'data/processed/sumstats-ldsc-corrected/{x["study"]}_{x["phenotype"]}_{x["population"]}_LDSC.txt', axis = 1).tolist()    
    return files

rule all:
    input:
        get_input,
        get_ldsc,
        metal = expand("data/processed/metal/{phenotype}-{population}_metal-1.txt", phenotype=config['create_metal_config']['phenotypes'], population=config['create_metal_config']['populations']),
        mrmega = expand("data/processed/mr-mega/{phenotype}-{population}.result", phenotype=config['create_metal_config']['phenotypes'], population=config['create_metal_config']['populations'])